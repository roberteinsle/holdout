{
  "name": "holdout",
  "image": "mcr.microsoft.com/devcontainers/php:8.5",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8080, 5173],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libicu-dev && sudo docker-php-ext-install intl bcmath && composer install && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "open-southeners.laravel-pint"]
    }
  }
}
